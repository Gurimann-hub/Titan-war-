# =============================================================================
# MULTI-AGENT NEWSROOM ENVIRONMENT VARIABLES
# =============================================================================

# LLM Providers (Required for live generation; fallback to deterministic template if blank)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# News & Market Data APIs (Optional: public RSS & SEC EDGAR work without keys)
FINNHUB_API_KEY=
NEWS_API_KEY=

# SEC EDGAR Custom User-Agent (Required by SEC: Sample: "NewsroomBot admin@example.com")
SEC_EDGAR_USER_AGENT=TitanWarNewsroom admin@titanwar.intel

# Publisher Method B - Webhook Token (Optional: used only if publisher.method=api)
PUBLISH_API_TOKEN=

# Runtime Overrides
NEWSROOM_DRY_RUN=true
NEWSROOM_APPROVAL_MODE=manual
NEWSROOM_KILL_SWITCH=false
