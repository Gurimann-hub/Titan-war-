# =========================================================================
# TITAN WAR // ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your environment values
# =========================================================================

# Runtime Environment: 'development' or 'production'
# In production: SESSION_SECRET, TURNSTILE keys, and live SMTP delivery are strictly enforced.
NODE_ENV=development
PORT=3000

# Local SQLite Database & Storage Directory (outside OneDrive sync)
TITAN_DATA_DIR=C:\Users\gurka\.titan_data

# Reverse Proxy & IP Rate Limiting Configuration
# Set to 'true' if running behind a trusted reverse proxy (e.g., Render, Railway, Nginx)
# Behind Cloudflare, 'cf-connecting-ip' is always automatically read first.
TRUST_PROXY=false

# Authentication Route Gate Enforcer
# Set to 'true' to require login session for the main root dashboard page (/)
ENFORCE_AUTH_GATE=false

# Host Authentication Credentials (Server-Side Only - Never expose in front-end)
# Password for host administrator account (alex.mercer@titan.corp)
HOST_PASSWORD=your_secure_host_password_here
HOST_SALT=your_custom_salt_string_here

# Administrator Gmail / Email for User Approval Gate
# All new sign-up requests will be emailed to this address for acceptance/rejection
ADMIN_EMAIL=your_admin_email@gmail.com
REQUIRE_ADMIN_APPROVAL=true

# Transactional SMTP Gateway Configuration
# NOTE: Personal Gmail is capped at ~500 emails/day and has poor deliverability.
# For production, use transactional providers (Resend, Postmark, AWS SES, Brevo) with a custom domain.
#
# Option A: Transactional SMTP (Recommended for Production)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_FROM="Titan War Command" <command@yourdomain.com>
#
# Option B: Gmail App Password (Convenient for local development only)
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail

# Cryptographic Session Secret (REQUIRED in production)
# Secret key for HMAC-SHA256 session token generation and verification.
# Must be consistent across instances and deploys; otherwise all sessions are invalidated on restart.
# Generate command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-persistent-32-byte-hex-string

# Cloudflare Turnstile Bot Protection (REQUIRED in production)
# Protects OTP endpoints against automation and mail-bombing attacks.
# In production, the server fails closed if these keys are missing.
# Register your domain at: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Architecture Constraint:
# In-memory maps (otpStore, ipOtpRequests, failedVerifications) require a single instance.
# For multi-instance horizontal scaling, integrate Redis or Upstash KV.
